{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "sporthub-workspace",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm --prefix frontend run build",
        "dev": "concurrently --names api,frontend --prefix-colors blue,green \"php artisan serve --port=8011\" \"npm --prefix frontend run dev\"",
        "dev:api": "php artisan serve --port=8011",
        "dev:frontend": "npm --prefix frontend run dev",
        "lint": "npm --prefix frontend run lint"
    },
    "devDependencies": {
        "concurrently": "^10.0.3"
    }
}
